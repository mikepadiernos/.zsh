# shellcheck shell=bash disable=SC1090,SC1091

_zsh_health_print_section() {
	local title="$1"
	printf '\n\033[1;36m%s\033[0m\n' "$title"
}

_zsh_health_status_line() {
	local label="$1"
	local value="$2"
	printf '  \033[1;33m%-18s\033[0m \033[38;5;250m%s\033[0m\n' "$label" "$value"
}

_zsh_health_detect_project() {
	local has_ddev=0
	local has_drupal=0
	local has_git=0
	local project_type="generic repo"
	local config_path=""
	local composer_text=""
	local package_text=""
	local docker_compose=0
	local has_wp=0
	local has_nextcloud=0
	local has_react=0
	local has_nextjs=0
	local has_node=0
	local has_python=0
	local has_php=0
	local has_wordpress=0
	local has_modx=0
	local has_cms=0
	local kw=""

	for config_path in .ddev/config.yaml .ddev/config.yml; do
		[[ -f "$config_path" ]] && has_ddev=1 && break
	done

	if [[ -f docker-compose.yml || -f compose.yaml || -f compose.yml ]]; then
		docker_compose=1
	fi

	if [[ -f web/sites/default/settings.php || -f sites/default/settings.php ]]; then
		has_drupal=1
	fi

	if [[ -f composer.json ]]; then
		composer_text="$(cat composer.json 2>/dev/null)"
		if [[ "$composer_text" == *"drupal"* ]]; then
			has_drupal=1
		fi
		if [[ "$composer_text" == *"wordpress"* || "$composer_text" == *"wp"* ]]; then
			has_wordpress=1
		fi
		if [[ "$composer_text" == *"nextcloud"* ]]; then
			has_nextcloud=1
		fi
		if [[ "$composer_text" == *"modx"* ]]; then
			has_modx=1
		fi
		if [[ "$composer_text" == *"laravel"* || "$composer_text" == *"symfony"* || "$composer_text" == *"craftcms"* || "$composer_text" == *"statamic"* ]]; then
			has_cms=1
		fi
		has_php=1
	fi

	if [[ -f package.json ]]; then
		package_text="$(cat package.json 2>/dev/null)"
		if [[ "$package_text" == *'"next"'* ]]; then
			has_nextjs=1
		fi
		if [[ "$package_text" == *'"react"'* || "$package_text" == *'"react-dom"'* ]]; then
			has_react=1
		fi
		has_node=1
	fi

	if [[ -f requirements.txt || -f pyproject.toml || -f setup.py || -f Pipfile ]]; then
		has_python=1
	fi

	if [[ -f wp-config.php ]]; then
		has_wordpress=1
	fi

	if [[ -f next.config.js || -f next.config.mjs || -f next.config.ts ]]; then
		has_nextjs=1
	fi

	if [[ -f .wordpress ]]; then
		has_wordpress=1
	fi

	if [[ -f config.php && -d core ]]; then
		has_nextcloud=1
	fi

	if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
		has_git=1
	fi

	if (( has_ddev )) && (( has_drupal )); then
		project_type="drupal + ddev"
	elif (( has_ddev )); then
		project_type="ddev"
	elif (( has_drupal )); then
		project_type="drupal"
	elif (( has_wordpress )); then
		project_type="wordpress"
	elif (( has_nextcloud )); then
		project_type="nextcloud"
	elif (( has_nextjs )); then
		project_type="next.js"
	elif (( has_react )); then
		project_type="react"
	elif (( has_node )); then
		project_type="node"
	elif (( has_python )); then
		project_type="python"
	elif (( has_php )); then
		project_type="php"
	elif (( docker_compose )); then
		project_type="docker-compose"
	elif (( has_git )); then
		project_type="git project"
	fi

	printf '%s\n' "$project_type"
	printf '%s\n' "$has_ddev"
	printf '%s\n' "$has_drupal"
}

_zsh_health_system_context() {
	local env_mode="native"
	local wsl_flag=""
	local vps_flag=""

	if [[ -n "${WSL_DISTRO_NAME:-}" || -f /proc/version && $(cat /proc/version 2>/dev/null) == *Microsoft* ]]; then
		env_mode="WSL"
	fi

	if [[ -n "${SSH_CONNECTION:-}" || -n "${SSH_TTY:-}" || -f /run/systemd/system ]] && [[ "$env_mode" != "WSL" ]]; then
		env_mode="VPS"
	fi

	if [[ "$env_mode" == "WSL" ]]; then
		_zsh_health_status_line "Environment" "WSL"
		_zsh_health_status_line "Distro" "${WSL_DISTRO_NAME:-unknown}"
		_zsh_health_status_line "Kernel" "$(uname -r 2>/dev/null || echo unknown)"
	elif [[ "$env_mode" == "VPS" ]]; then
		_zsh_health_status_line "Environment" "VPS"
		_zsh_health_status_line "SSH" "$( [[ -n "${SSH_CONNECTION:-}" ]] && echo connected || echo not connected )"
		_zsh_health_status_line "Init" "$(ps -p 1 -o comm= 2>/dev/null || echo unknown)"
	else
		_zsh_health_status_line "Environment" "native"
	fi
}

_zsh_health_system() {
	local project_dir="${PWD:-$HOME}"
	local disk_line="unknown"
	local git_branch="not a git repo"
	local git_state="unknown"
	local shell_name="${SHELL:-unknown}"
	local os_name="$(uname -s 2>/dev/null || echo unknown)"
	local os_rel="$(uname -r 2>/dev/null || echo unknown)"
	local arch="$(uname -m 2>/dev/null || echo unknown)"
	local uptime_line="unknown"
	local project_type="$( _zsh_health_detect_project | head -n 1 )"
	local has_ddev="$( _zsh_health_detect_project | sed -n '2p' )"
	local has_drupal="$( _zsh_health_detect_project | sed -n '3p' )"

	if command -v df >/dev/null 2>&1; then
		disk_line="$(df -h . 2>/dev/null | awk 'NR==2 {print $3 "/" $2 " used, " $4 " avail"}')"
		[[ -n "$disk_line" ]] || disk_line="unknown"
	fi

	if command -v uptime >/dev/null 2>&1; then
		uptime_line="$(uptime 2>/dev/null | sed 's/^.*up //' || echo unknown)"
	fi

	if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
		git_branch="$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null || echo detached)"
		git_state="$(git status --short --branch 2>/dev/null | head -n 1 || echo clean)"
	fi

	_zsh_health_status_line "Project" "$project_dir"
	_zsh_health_status_line "Type" "$project_type"
	_zsh_health_status_line "OS" "$os_name $os_rel ($arch)"
	_zsh_health_status_line "Shell" "$shell_name"
	_zsh_health_status_line "User" "${USER:-$(id -un 2>/dev/null || echo unknown)}"
	_zsh_health_status_line "Disk" "$disk_line"
	_zsh_health_status_line "Uptime" "$uptime_line"
	_zsh_health_status_line "Git" "$git_branch"
	_zsh_health_status_line "Git state" "$git_state"
	_zsh_health_system_context
}

_zsh_health_docker() {
	if ! command -v docker >/dev/null 2>&1; then
		_zsh_health_status_line "Docker" "not installed"
		return 1
	fi

	if ! docker info >/dev/null 2>&1; then
		_zsh_health_status_line "Docker" "daemon unavailable"
		return 1
	fi

	_zsh_health_status_line "Docker" "available"
	_zsh_health_status_line "Context" "$(docker context show 2>/dev/null || echo default)"
	_zsh_health_status_line "Containers" "$(docker ps --format '{{.Names}}' 2>/dev/null | wc -l | tr -d ' ')"
	return 0
}

_zsh_health_ddev() {
	local ddev_status=1
	local ddev_config=""

	if ! command -v ddev >/dev/null 2>&1; then
		_zsh_health_status_line "DDEV" "not installed"
		return 1
	fi

	for ddev_config in .ddev/config.yaml .ddev/config.yml .ddev/config.yaml; do
		[[ -f "$ddev_config" ]] && break
	done

	if [[ ! -f "$ddev_config" ]]; then
		_zsh_health_status_line "DDEV" "not configured in this directory"
		return 1
	fi

	if ddev status >/tmp/zsh_health_ddev_status 2>&1; then
		_zsh_health_status_line "DDEV" "healthy"
		printf '    status:\n'
		sed -n '1,8p' /tmp/zsh_health_ddev_status
		ddev_status=0
	else
		_zsh_health_status_line "DDEV" "unhealthy or not running"
		printf '    status:\n'
		sed -n '1,8p' /tmp/zsh_health_ddev_status 2>/dev/null || true
		return 1
	fi

	return "$ddev_status"
}

_zsh_health_drupal() {
	local drupal_dir=0
	local drush_state="not available"
	local drupal_config=""

	for drupal_config in web/sites/default/settings.php sites/default/settings.php; do
		[[ -f "$drupal_config" ]] && drupal_dir=1
	done

	if [[ $drupal_dir -eq 0 ]] && [[ ! -f composer.json || ! -f .ddev/config.yaml ]]; then
		_zsh_health_status_line "Drupal" "not detected in this project"
		return 1
	fi

	_zsh_health_status_line "Drupal" "detected"
	if [[ -f web/sites/default/settings.php ]]; then
		_zsh_health_status_line "Settings" "web/sites/default/settings.php"
	fi
	if [[ -f sites/default/settings.php ]]; then
		_zsh_health_status_line "Settings" "sites/default/settings.php"
	fi

	if command -v drush >/dev/null 2>&1; then
		if drush status --fields=bootstrap,db-status,db-driver,uri 2>/dev/null; then
			drush_state="healthy"
		else
			drush_state="unhealthy"
		fi
		_zsh_health_status_line "Drush" "$drush_state"
		return 0
	fi

	if command -v ddev >/dev/null 2>&1 && [[ -f .ddev/config.yaml ]]; then
		if ddev drush status --fields=bootstrap,db-status,db-driver,uri >/tmp/zsh_health_drush_status 2>&1; then
			_zsh_health_status_line "Drush via ddev" "healthy"
			sed -n '1,6p' /tmp/zsh_health_drush_status
			return 0
		fi
		_zsh_health_status_line "Drush via ddev" "unavailable"
		return 1
	fi

	_zsh_health_status_line "Drush" "not available"
	return 1
}

zsh_health() {
	local exit_code=0
	local arg="${1:-}"
	local has_ddev=0
	local has_drupal=0
	local project_detected=""

	project_detected="$( _zsh_health_detect_project | head -n 1 )"
	has_ddev="$( _zsh_health_detect_project | sed -n '2p' )"
	has_drupal="$( _zsh_health_detect_project | sed -n '3p' )"

	case "$arg" in
		--help|-h)
			cat <<'EOF'
Usage: zsh_health

Print a health report for the current project directory, including:
- system status
- docker status
- ddev status (when configured)
- drupal status (when detected)
EOF
			return 0
			;;
		"")
			;;
		*)
			echo "zsh_health: unknown argument '$arg'"
			echo "try: zsh_health --help"
			return 1
			;;
	esac

	clear 2>/dev/null || printf '\033[H\033[2J\033[3J\033[0m'
	printf '\n\033[1;35mProject health report\033[0m\n\n'
	_zsh_health_print_section "System"
	_zsh_health_system

	_zsh_health_print_section "Docker"
	_zsh_health_docker || exit_code=1

	if (( has_ddev )); then
		_zsh_health_print_section "DDEV"
		_zsh_health_ddev || true
	fi

	if (( has_drupal )); then
		_zsh_health_print_section "Drupal"
		_zsh_health_drupal || true
	fi

	printf '\n\033[1;32mHealth check complete\033[0m\n'
	printf '\033[38;5;250mProject type: %s\033[0m\n' "$project_detected"
	printf '\n\n'
}

alias zsh-health='zsh_health'
