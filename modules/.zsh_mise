# shellcheck shell=bash disable=SC1090,SC1091,SC2154,SC2168,SC1036,SC2034,SC2207,SC2086,SC2046
__mise_setup_script="$HOME/.files/scripts/setup-mise.sh"
__mise_local_bin="$HOME/.local/bin/mise"
typeset -g ZSH_STARTUP_ALLOW_INSTALLS="${ZSH_STARTUP_ALLOW_INSTALLS:-false}"

if ! command -v mise >/dev/null 2>&1 && [ -x "$__mise_setup_script" ]; then
  if zsh_startup_is_truthy "$ZSH_STARTUP_ALLOW_INSTALLS"; then
    bash "$__mise_setup_script" >/dev/null 2>&1
    hash -r
  fi
fi

if ! command -v mise >/dev/null 2>&1 && [ -x "$__mise_local_bin" ]; then
  export PATH="$HOME/.local/bin:$PATH"
  hash -r
fi

if command -v mise >/dev/null 2>&1; then
  zsh_startup_log "\e[30;42m MISE \e[0m" "\e[32minstalled\e[0m"
fi

unset __mise_setup_script
unset __mise_local_bin

# Activate mise last so its PATH entries take precedence over brew/system tools
source_if_exists "$ZSH_PLUGINS/zsh-mise/zsh-mise.plugin.zsh"

