# shellcheck shell=bash disable=SC1090,SC1091

typeset -g ZSH_NU_TABLE_USE_ALL="${ZSH_NU_TABLE_USE_ALL:-true}"
typeset -g ZSH_NU_TABLE_STYLE="${ZSH_NU_TABLE_STYLE:-encoded}"
typeset -g ZSH_NU_TABLE_MIN_WIDTH_PERCENT="${ZSH_NU_TABLE_MIN_WIDTH_PERCENT:-50}"

_zsh_table_ensure_lll() {
	local lll_path="${HOME}/.local/bin/lll"
	local lll_dir="${HOME}/.local/bin"
	local existing_lll=""

	if command -v lll >/dev/null 2>&1; then
		existing_lll="$(command -v lll)"
		if [[ "$existing_lll" == "$lll_path" ]] && grep -q 'source.*\.zsh_table\|nls_table' "$lll_path" 2>/dev/null; then
			return 0
		fi
	fi

	mkdir -p "$lll_dir" 2>/dev/null || return 0
	cat > "$lll_path" <<'EOF'
#!/usr/bin/env zsh
emulate -L zsh
if [[ -f "$HOME/.zsh/modules/.zsh_table" ]]; then
  source "$HOME/.zsh/modules/.zsh_table" >/dev/null 2>&1 || true
fi
if whence -w lll >/dev/null 2>&1; then
  lll "$@"
  exit $?
fi
exec ls -l --group-directories-first --color=auto "$@"
EOF
	chmod +x "$lll_path" 2>/dev/null || return 0

	case ":$PATH:" in
		*":$lll_dir:"*) ;;
		*) export PATH="$lll_dir:$PATH" ;;
	esac
}

_zsh_table_ensure_lll

lll() {
	lll_table "$@"
}

_lll_human_size() {
	local bytes="$1"
	local -a units=("B" "KiB" "MiB" "GiB" "TiB" "PiB")
	local unit_index=1
	local scaled="$bytes"

	[[ "$bytes" == <-> ]] || {
		print -r -- "-"
		return 0
	}

	while (( scaled >= 1024 && unit_index < ${#units[@]} )); do
		scaled=$(( scaled / 1024 ))
		unit_index=$(( unit_index + 1 ))
	done

	print -r -- "$scaled ${units[unit_index]}"
}

_lll_format_epoch() {
	local epoch="$1"

	[[ "$epoch" == <-> ]] || {
		print -r -- "-"
		return 0
	}

	if command date -d "@$epoch" '+%Y.%m.%d - %H:%M:%S' >/dev/null 2>&1; then
		command date -d "@$epoch" '+%Y.%m.%d - %H:%M:%S'
		return 0
	fi

	if command date -r "$epoch" '+%Y.%m.%d - %H:%M:%S' >/dev/null 2>&1; then
		command date -r "$epoch" '+%Y.%m.%d - %H:%M:%S'
		return 0
	fi

	print -r -- "-"
}

_lll_stat_size_epoch() {
	local path="$1"
	local stat_bin=""

	if [[ -x "/usr/bin/stat" ]]; then
		stat_bin="/usr/bin/stat"
	elif [[ -x "/bin/stat" ]]; then
		stat_bin="/bin/stat"
	else
		return 1
	fi

	if "$stat_bin" --version >/dev/null 2>&1; then
		"$stat_bin" -c '%s|%Y' -- "$path" 2>/dev/null
		return $?
	fi

	"$stat_bin" -f '%z|%m' -- "$path" 2>/dev/null
}

_lll_stat_mode_owner_group() {
	local path="$1"
	local stat_bin=""
	local permissions="-"
	local owner="-"
	local group="-"

	if [[ -x "/usr/bin/stat" ]]; then
		stat_bin="/usr/bin/stat"
	elif [[ -x "/bin/stat" ]]; then
		stat_bin="/bin/stat"
	else
		print -r -- "-|-|-"
		return 0
	fi

	if "$stat_bin" --version >/dev/null 2>&1; then
		permissions="$($stat_bin -c '%A' -- "$path" 2>/dev/null)"
		owner="$($stat_bin -c '%U' -- "$path" 2>/dev/null)"
		group="$($stat_bin -c '%G' -- "$path" 2>/dev/null)"
	else
		permissions="$($stat_bin -f '%p' -- "$path" 2>/dev/null)"
		owner="$($stat_bin -f '%Su' -- "$path" 2>/dev/null)"
		group="$($stat_bin -f '%Sg' -- "$path" 2>/dev/null)"
	fi

	permissions="${permissions:--}"
	owner="${owner:--}"
	group="${group:--}"
	print -r -- "${permissions}|${owner}|${group}"
}

_lll_render_table() {
	local style="${1:-ascii}"
	local min_total_width="${2:-0}"
	local link_color="${3:-}"
	local reset_color="${4:-}"
	local top_left="+"
	local top_mid="+"
	local top_right="+"
	local mid_left="+"
	local mid_mid="+"
	local mid_right="+"
	local bottom_left="+"
	local bottom_mid="+"
	local bottom_right="+"
	local horizontal="-"
	local vertical="|"

	case "${(L)style}" in
		encoded|unicode|utf8|box)
			top_left='╭'
			top_mid='┬'
			top_right='╮'
			mid_left='├'
			mid_mid='┼'
			mid_right='┤'
			bottom_left='╰'
			bottom_mid='┴'
			bottom_right='╯'
			horizontal='─'
			vertical='│'
			;;
		*)
			;;
	esac

	command awk -v min_total_width="$min_total_width" -v link_color="$link_color" -v reset_color="$reset_color" -v tl="$top_left" -v tm="$top_mid" -v tr="$top_right" -v ml="$mid_left" -v mm="$mid_mid" -v mr="$mid_right" -v bl="$bottom_left" -v bm="$bottom_mid" -v br="$bottom_right" -v h="$horizontal" -v v="$vertical" '
	BEGIN {
		FS = "\t"
		border_color = "\033[37m"
		header_color = "\033[1;37m"
		permissions_color = "\033[35m"
		owner_color = "\033[33m"
		group_color = "\033[1;35m"
		file_color = "\033[34m"
		dir_color = "\033[32m"
		size_color = "\033[36m"
		modified_color = "\033[38;5;245m"
	}
	{
		rows = NR
		cols = (NF > cols ? NF : cols)
		for (i = 1; i <= NF; i++) {
			cells[NR, i] = $i
			if (length($i) > widths[i]) {
				widths[i] = length($i)
			}
		}
	}
	function repeat(ch, count, out, i) {
		out = ""
		for (i = 0; i < count; i++) {
			out = out ch
		}
		return out
	}
	function header_col_index(col_name, i) {
		for (i = 1; i <= cols; i++) {
			if (cells[1, i] == col_name) {
				return i
			}
		}
		return 0
	}
	function border(left, mid, right, line, i) {
		line = left
		for (i = 1; i <= cols; i++) {
			line = line h repeat(h, widths[i]) h
			if (i < cols) {
				line = line mid
			} else {
				line = line right
			}
		}
		return line
	}
	function render_cell(row_number, col_index, raw_value, value, header_name, type_value, color) {
		raw_value = cells[row_number, col_index]
		header_name = cells[1, col_index]
		value = sprintf(" %-" widths[col_index] "s ", raw_value)

		if (row_number == 1) {
			return header_color value reset_color
		}

		if (header_name == "permissions") {
			return permissions_color value reset_color
		}
		if (header_name == "owner") {
			return owner_color value reset_color
		}
		if (header_name == "group") {
			return group_color value reset_color
		}
		if (header_name == "name") {
			if (type_col > 0 && cells[row_number, type_col] == "link") {
				return link_color value reset_color
			}
			if (type_col > 0 && cells[row_number, type_col] == "dir") {
				return dir_color value reset_color
			}
			if (type_col > 0 && cells[row_number, type_col] == "file") {
				return file_color value reset_color
			}
			return file_color value reset_color
		}
		if (header_name == "type") {
			type_value = cells[row_number, col_index]
			if (type_value == "dir") return dir_color value reset_color
			if (type_value == "file") return file_color value reset_color
			if (type_value == "link") return link_color value reset_color
			return value
		}
		if (header_name == "size") {
			return size_color value reset_color
		}
		if (header_name == "modified") {
			return modified_color value reset_color
		}
		return value
	}
	function render_row(row_number, line, i, value) {
		line = border_color v reset_color
		for (i = 1; i <= cols; i++) {
			value = render_cell(row_number, i)
			line = line value
			line = line border_color v reset_color
		}
		print line
	}
	END {
		if (rows == 0) {
			exit 0
		}

		name_col = header_col_index("name")
		type_col = header_col_index("type")

		if (min_total_width > 0) {
			current_total = 1
			for (i = 1; i <= cols; i++) {
				current_total += widths[i] + 3
			}

			if (current_total < min_total_width) {
				extra = min_total_width - current_total
				grow_col = cols
				for (i = 1; i <= cols; i++) {
					if (cells[1, i] == "name") {
						grow_col = i
						break
					}
				}
				widths[grow_col] += extra
			}
		}

		print border_color border(tl, tm, tr) reset_color
		render_row(1)
		print border_color border(ml, mm, mr) reset_color

		for (r = 2; r <= rows; r++) {
			render_row(r)
		}

		print border_color border(bl, bm, br) reset_color
	}
	'
}


_lll_target_has_symlink() {
	local target="$1"
	local include_all="$2"
	local -a entries
	local entry=""

	if [[ -d "$target" ]]; then
		if [[ "$include_all" == true ]]; then
			entries=("$target"/*(DN))
		else
			entries=("$target"/*(N))
		fi
	elif [[ -e "$target" || -L "$target" ]]; then
		entries=("$target")
	else
		return 1
	fi

	for entry in "${entries[@]}"; do
		[[ -L "$entry" ]] && return 0
	done

	return 1
}

_lll_type_for_path() {
	local path="$1"

	if [[ -L "$path" ]]; then
		print -r -- "link"
		return 0
	fi

	if [[ -d "$path" ]]; then
		print -r -- "dir"
		return 0
	fi

	if [[ -f "$path" ]]; then
		print -r -- "file"
		return 0
	fi

	print -r -- "other"
}

_lll_table_for_target() {
	local target="$1"
	local include_all="$2"
	local style="$3"
	local min_total_width="${4:-0}"
	local sort_field="${5:-default}"
	local sort_dir="${6:-asc}"
	local -a entries
	local -a rows
	local entry=""
	local row_index=0
	local stats=""
	local stats_size=""
	local stats_epoch=""
	local size_human=""
	local modified=""
	local item_type=""
	local item_name=""
	local link_target=""
	local row_label=""
	local tab=$'\t'

	if [[ -d "$target" ]]; then
		if [[ "$include_all" == true ]]; then
			entries=("$target"/*(DN))
		else
			entries=("$target"/*(N))
		fi
	elif [[ -e "$target" || -L "$target" ]]; then
		entries=("$target")
	else
		print -u2 -- "lll: cannot access '$target'"
		return 1
	fi

	local -a sorted_entries=()
	local -a sort_lines=()
	local -a sort_args=()
	local sort_line=""
	local sort_output=""
	local sort_bucket=""
	local sort_key1="0"
	local sort_key2="0"
	local sort_name=""
	local sort_type=""
	local sort_entry=""

	if [[ "$sort_field" == "default" ]]; then
		for sort_entry in "${entries[@]}"; do
			sort_name="${sort_entry:t}"
			sort_type="$(_lll_type_for_path "$sort_entry")"
			sort_bucket="4"
			case "$sort_type" in
				dir)
					if [[ "$sort_name" == .* ]]; then
						sort_bucket="00"
					else
						sort_bucket="10"
					fi
					;;
				link)
					if [[ -d "$sort_entry" ]]; then
						if [[ "$sort_name" == .* ]]; then
							sort_bucket="00"
						else
							sort_bucket="10"
						fi
					else
						if [[ "$sort_name" == .* ]]; then
							sort_bucket="20"
						else
							sort_bucket="30"
						fi
					fi
					;;
				file)
					if [[ "$sort_name" == .* ]]; then
						sort_bucket="20"
					else
						sort_bucket="30"
					fi
					;;
				*)
					sort_bucket="40"
					;;
			esac
			printf -v sort_line '%s\t%s\t%s' "$sort_bucket" "${sort_name:l}" "$sort_entry"
			sort_lines+=("$sort_line")
		done
		if (( ${#sort_lines[@]} > 0 )); then
			sort_output="$(printf '%s\n' "${sort_lines[@]}" | sort -t $'\t' -k1,1 -k2,2 | cut -f3-)"
			entries=("${(@f)sort_output}")
		fi
	else
		for sort_entry in "${entries[@]}"; do
			sort_name="${sort_entry:t}"
			sort_key1="0"
			sort_key2="0"
			stats="$(_lll_stat_size_epoch "$sort_entry")"
			if [[ -n "$stats" ]]; then
				sort_key1="${stats%%|*}"
				sort_key2="${stats##*|}"
			fi
			if [[ "$sort_field" == "size" ]]; then
				printf -v sort_line '%020d\t%s\t%s' "$sort_key1" "${sort_name:l}" "$sort_entry"
			elif [[ "$sort_field" == "modified" ]]; then
				printf -v sort_line '%020d\t%s\t%s' "$sort_key2" "${sort_name:l}" "$sort_entry"
			elif [[ "$sort_field" == "both" ]]; then
				printf -v sort_line '%020d\t%020d\t%s\t%s' "$sort_key1" "$sort_key2" "${sort_name:l}" "$sort_entry"
			else
				printf -v sort_line '%s\t%s\t%s' "0" "${sort_name:l}" "$sort_entry"
			fi
			sort_lines+=("$sort_line")
		done
		if (( ${#sort_lines[@]} > 0 )); then
			if [[ "$sort_field" == "both" ]]; then
				if [[ "$sort_dir" == "desc" || "$sort_dir" == "dsc" ]]; then
					sort_args=(-t $'\t' -k1,1nr -k2,2nr)
				else
					sort_args=(-t $'\t' -k1,1n -k2,2n)
				fi
			else
				if [[ "$sort_dir" == "desc" || "$sort_dir" == "dsc" ]]; then
					sort_args=(-t $'\t' -k1,1nr -k2,2)
				else
					sort_args=(-t $'\t' -k1,1n -k2,2)
				fi
			fi
			sort_output="$(printf '%s\n' "${sort_lines[@]}" | sort "${sort_args[@]}" | cut -f3-)"
			entries=("${(@f)sort_output}")
		fi
	fi

	rows+=("${tab}name${tab}type${tab}permissions${tab}owner${tab}group${tab}size${tab}modified")

	for entry in "${entries[@]}"; do
		stats="$(_lll_stat_size_epoch "$entry")"
		if [[ -n "$stats" ]]; then
			stats_size="${stats%%|*}"
			stats_epoch="${stats##*|}"
		else
			stats_size=""
			stats_epoch=""
		fi

		local stat_meta=""
		local permissions="-"
		local owner="-"
		local group="-"
		stat_meta="$(_lll_stat_mode_owner_group "$entry")"
		if [[ -n "$stat_meta" ]]; then
			permissions="${stat_meta%%|*}"
			stat_meta="${stat_meta#*|}"
			owner="${stat_meta%%|*}"
			group="${stat_meta##*|}"
		fi

		size_human="$(_lll_human_size "$stats_size")"
		modified="$(_lll_format_epoch "$stats_epoch")"
		item_type="$(_lll_type_for_path "$entry")"
		item_name="${entry:t}"
		item_name="${item_name//$'\t'/ }"
		item_name="${item_name//$'\n'/ }"
		if [[ "$item_type" == "link" ]]; then
			link_target="$(command readlink -- "$entry" 2>/dev/null)"
			link_target="${link_target//$'\t'/ }"
			link_target="${link_target//$'\n'/ }"
			if [[ -n "$link_target" ]]; then
				item_name="${item_name} -> ${link_target}"
			fi
		fi

		printf -v row_label '%02d' "$row_index"
		rows+=("$row_label${tab}$item_name${tab}$item_type${tab}$permissions${tab}$owner${tab}$group${tab}$size_human${tab}$modified")
		row_index=$(( row_index + 1 ))
	done

	printf '%s\n' "${rows[@]}" | _lll_render_table "$style" "$min_total_width" $'\033[36m' $'\033[0m'
}

_lll_terminal_columns() {
	local cols=""

	if [[ "${COLUMNS:-}" == <-> ]] && (( COLUMNS > 0 )); then
		print -r -- "$COLUMNS"
		return 0
	fi

	if command -v tput >/dev/null 2>&1; then
		cols="$(command tput cols 2>/dev/null)"
		if [[ "$cols" == <-> ]] && (( cols > 0 )); then
			print -r -- "$cols"
			return 0
		fi
	fi

	print -r -- "0"
}

lll_table() {
	local -a targets
	local -a raw_args
	local arg=""
	local target=""
	local exit_code=0
	local first=true
	local include_all=false
	local table_style="${ZSH_NU_TABLE_STYLE:-ascii}"
	local use_nu=true
	local has_symlinks=false
	local terminal_columns=0
	local min_total_width=0
	local width_percent="${ZSH_NU_TABLE_MIN_WIDTH_PERCENT:-50}"
	local sort_field="default"
	local sort_dir="asc"

	raw_args=("$@")
	targets=()

	for arg in "${raw_args[@]}"; do
		case "$arg" in
			--ascii)
				table_style="ascii"
				;;
			--encoded|--unicode|--utf8|--box)
				table_style="encoded"
				;;
			--all)
				include_all=true
				;;
			--no-all)
				include_all=false
				;;
			--sort=*)
				sort_field="${arg#*=}"
				sort_field="${(L)sort_field}"
				;;
			--sort-size|--size-asc)
				sort_field="size"
				sort_dir="asc"
				;;
			--size-dsc|--size-desc)
				sort_field="size"
				sort_dir="desc"
				;;
			--sort-modified|--modified-asc)
				sort_field="modified"
				sort_dir="asc"
				;;
			--modified-dsc|--modified-desc)
				sort_field="modified"
				sort_dir="desc"
				;;
			--sort-both|--both-asc)
				sort_field="both"
				sort_dir="asc"
				;;
			--both-dsc|--both-desc)
				sort_field="both"
				sort_dir="desc"
				;;
			--asc|--ascending)
				sort_dir="asc"
				;;
			--desc|--dsc|--descending)
				sort_dir="desc"
				;;
			--help)
				print -r -- "usage: lll [--ascii|--encoded] [--all|--no-all] [--sort=size|modified|both] [--asc|--desc] [path ...]"
				return 0
				;;
			*)
				targets+=("$arg")
				;;
		esac
	done

	(( ${#targets[@]} )) || targets=(".")
	if [[ "$include_all" == false ]]; then
		if (( ${+functions[zsh_startup_is_truthy]} )); then
			zsh_startup_is_truthy "$ZSH_NU_TABLE_USE_ALL" && include_all=true
		elif [[ "${ZSH_NU_TABLE_USE_ALL:-true}" == [Tt]rue ]]; then
			include_all=true
		fi
	fi

	[[ "${(L)table_style}" == "ascii" ]] && use_nu=false

	if [[ "$use_nu" == true ]] && command -v nu >/dev/null 2>&1; then
		for target in "${targets[@]}"; do
			if _lll_target_has_symlink "$target" "$include_all"; then
				has_symlinks=true
				break
			fi
		done
	fi

	if [[ "$width_percent" != <-> ]]; then
		width_percent=50
	fi
	(( width_percent < 1 )) && width_percent=1
	(( width_percent > 100 )) && width_percent=100

	if [[ "${(L)table_style}" == "encoded" ]]; then
		terminal_columns="$(_lll_terminal_columns)"
		if [[ "$terminal_columns" == <-> ]] && (( terminal_columns > 0 )); then
			min_total_width=$(( (terminal_columns * width_percent + 99) / 100 ))
		fi
	fi

	if [[ "$use_nu" == true && "$has_symlinks" == false ]] && command -v nu >/dev/null 2>&1; then
		for target in "${targets[@]}"; do
			if (( ${#targets[@]} > 1 )); then
				[[ "$first" == true ]] || printf '\n'
				first=false
				printf '==> %s <==\n' "$target"
			fi

			if zsh_startup_is_truthy "$ZSH_NU_TABLE_USE_ALL"; then
				env NLS_TARGET="$target" command nu -c 'ls -a $env.NLS_TARGET | sort-by type | select name type permissions owner group size modified | table' || exit_code=$?
			else
				env NLS_TARGET="$target" command nu -c 'ls $env.NLS_TARGET | sort-by type | select name type permissions owner group size modified | table' || exit_code=$?
			fi
		done
		return "$exit_code"
	fi

	for target in "${targets[@]}"; do
		if (( ${#targets[@]} > 1 )); then
			[[ "$first" == true ]] || printf '\n'
			first=false
			printf '==> %s <==\n' "$target"
		fi

		_lll_table_for_target "$target" "$include_all" "$table_style" "$min_total_width" "$sort_field" "$sort_dir" || exit_code=$?
	done

	return "$exit_code"
}

nls_table() {
	lll_table "$@"
}

alias lstable='lll'
